{
  "name": "@jacktea/img-viewer",
  "version": "0.1.7",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacktea/img-viewer.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "dist/img-viewer.umd.cjs",
  "module": "dist/img-viewer.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/img-viewer.js",
      "require": "./dist/img-viewer.umd.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "third_party/licenses"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && tsc --emitDeclarationOnly --outDir dist",
    "prepack": "node ../../scripts/sync-core-license.mjs copy",
    "postpack": "node ../../scripts/sync-core-license.mjs clean"
  },
  "dependencies": {
    "@webtoon/psd": "^0.4.0"
  }
}
